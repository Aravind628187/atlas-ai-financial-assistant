# ─────────────────────────────────────────────
# Atlas AI — Environment Configuration
# Copy this file to `.env` and fill in your keys.
# ─────────────────────────────────────────────

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=ATLASAI2026BOT

# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_COOLDOWN_SECONDS=300

# Database (SQLite by default, drop in any SQLAlchemy URL for Postgres/MySQL)
DATABASE_URL=sqlite:///./data/atlas.db

# Optional multi-provider financial data. Missing keys are skipped safely.
FINNHUB_API_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
MASSIVE_API_KEY=

# Intent-aware router preference and backward-compatible generic keys.
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=
SECONDARY_MARKET_DATA_PROVIDER=yfinance
SECONDARY_MARKET_DATA_API_KEY=
FINANCIAL_PROVIDER_VERIFY_CRITICAL=true
FINANCIAL_PROVIDER_TIMEOUT_SECONDS=8
FINANCIAL_PROVIDER_MAX_RETRIES=2
QUOTE_CACHE_TTL_SECONDS=30
NEWS_CACHE_TTL_SECONDS=300
FUNDAMENTALS_CACHE_TTL_SECONDS=21600
QUOTE_STALE_AFTER_SECONDS=900
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
QUOTE_VERIFICATION_TOLERANCE_PCT=0.5
PE_VERIFICATION_TOLERANCE_PCT=15
MARKET_CAP_VERIFICATION_TOLERANCE_PCT=5
SEC_USER_AGENT=AtlasAI/1.0 your-email@example.com
SEC_CACHE_TTL_SECONDS=900
MAX_WATCHLIST_ITEMS=25

# Optional: Google OAuth (Gmail / Calendar / Drive / Sheets) — used only if
# a user connects an account during onboarding. Leave blank to disable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Dashboard / API server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Admin login
ADMIN_EMAIL=admin@atlasai.com
ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Price-alert polling interval (seconds)
ALERT_POLL_INTERVAL_SECONDS=300

# Timezone used for scheduling daily briefings (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata
