# ─────────────────────────────────────────────
# Atlas AI — Environment Configuration
# Copy this file to `.env` and fill in your keys.
# ─────────────────────────────────────────────

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Database (SQLite by default, drop in any SQLAlchemy URL for Postgres/MySQL)
DATABASE_URL=sqlite:///./data/atlas.db

# Optional: NewsAPI.org key for richer news search (free tier works)
# Leave blank to fall back to Yahoo Finance / Google News RSS (no key needed)
NEWS_API_KEY=

# Optional: Google OAuth (Gmail / Calendar / Drive / Sheets) — used only if
# a user connects an account during onboarding. Leave blank to disable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Dashboard / API server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Price-alert polling interval (seconds)
ALERT_POLL_INTERVAL_SECONDS=300

# Timezone used for scheduling daily briefings (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata
